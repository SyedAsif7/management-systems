{
  "version": 2,
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 15,
      "regions": ["sin1"]
    }
  },
  "routes": [
    {
      "src": "/(assets|global_assets)/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(css|js|images|fonts|favicon.ico|robots.txt)/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "AL-TAQWA INSTITUTE",
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_URL": "https://www.altaqwauniversity.com",
    "DISPLAY_ERRORS": "0",
    "DB_CONNECTION": "mysql",
    "DB_HOST": "gateway01.ap-southeast-1.prod.aws.tidbcloud.com",
    "DB_PORT": "4000",
    "DB_DATABASE": "altaqwa",
    "DB_USERNAME": "3RwFR6heZw8fbBg.root",
    "DB_PASSWORD": "8qH1vwhi5zQOjB9h",
    "MYSQL_ATTR_SSL_CA": "isrgrootx1.pem",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_DRIVER": "array",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "APP_STORAGE": "/tmp/storage"
  }
}
