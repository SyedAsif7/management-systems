{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/(assets|global_assets)/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(css|js|images|fonts|favicon.ico|robots.txt)/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "AL-TAQWA INSTITUTE",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://altaqwauniversity.com",
    "DISPLAY_ERRORS": "0",
    "DB_CONNECTION": "mysql",
    "DB_HOST": "mysql-2c53004d-management-systems.c.aivencloud.com",
    "DB_PORT": "27056",
    "DB_DATABASE": "defaultdb",
    "DB_USERNAME": "avnadmin",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_DRIVER": "array",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "APP_STORAGE": "/tmp/storage"
  }
}
